---
# Checks follow the style of app/logger.*: brace initialisation with `auto`,
# `const` wherever a value is not reassigned, [[nodiscard]] on results that
# must not be ignored, trailing underscore on members.
#
# Left out on purpose:
#   modernize-use-trailing-return-type   not the house style
#   modernize-avoid-c-arrays             task stacks and queue storage are
#                                        fixed-size arrays by design
#   cppcoreguidelines-pro-type-reinterpret-cast, ...-bounds-*
#                                        memory-mapped registers need them
#   readability-magic-numbers            register addresses and bit masks
#   readability-uppercase-literal-suffix lower-case `u` and `f` are used
#   readability-identifier-length        short loop and register names are fine
#   readability-named-parameter          task entries and FreeRTOS hooks ignore
#                                        their argument
#   readability-trailing-comma           fights clang-format's compact braces
#   performance-no-int-to-ptr            memory-mapped registers
#   performance-enum-size                priorities are UBaseType_t on purpose
#   readability-inconsistent-declaration-parameter-name
#                                        FreeRTOS hooks: it fixes the types, not
#                                        the parameter names
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-special-member-functions,
  misc-const-correctness,
  misc-definitions-in-headers,
  misc-unused-using-decls,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-uppercase-literal-suffix,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-named-parameter,
  -readability-trailing-comma,
  -performance-no-int-to-ptr,
  -performance-enum-size,
  -readability-inconsistent-declaration-parameter-name

# Only our code, not FreeRTOS or the toolchain headers.
# FreeRTOSConfig.h stays out: its macros must remain macros.
HeaderFilterRegex: '(app|bsp/include|osal)/'
WarningsAsErrors: ''

CheckOptions:
  # Types and templates: CamelCase.
  - { key: readability-identifier-naming.NamespaceCase, value: lower_case }
  - { key: readability-identifier-naming.ClassCase, value: CamelCase }
  - { key: readability-identifier-naming.StructCase, value: CamelCase }
  - { key: readability-identifier-naming.EnumCase, value: CamelCase }
  - { key: readability-identifier-naming.TemplateParameterCase, value: CamelCase }
  - { key: readability-identifier-naming.TypeAliasCase, value: CamelCase }
  # Functions, methods, variables and parameters: camelBack.
  - { key: readability-identifier-naming.FunctionCase, value: camelBack }
  - { key: readability-identifier-naming.MethodCase, value: camelBack }
  - { key: readability-identifier-naming.VariableCase, value: camelBack }
  - { key: readability-identifier-naming.ParameterCase, value: camelBack }
  # Private data members end in an underscore: buffer_, capacity_.
  - { key: readability-identifier-naming.PrivateMemberCase, value: camelBack }
  - { key: readability-identifier-naming.PrivateMemberSuffix, value: _ }
  - { key: readability-identifier-naming.PublicMemberCase, value: camelBack }
  # Constants and enumerators: kName.
  - { key: readability-identifier-naming.ConstexprVariableCase, value: CamelCase }
  - { key: readability-identifier-naming.ConstexprVariablePrefix, value: k }
  - { key: readability-identifier-naming.GlobalConstantCase, value: CamelCase }
  - { key: readability-identifier-naming.GlobalConstantPrefix, value: k }
  - { key: readability-identifier-naming.EnumConstantCase, value: CamelCase }
  - { key: readability-identifier-naming.EnumConstantPrefix, value: k }
  # Matches `const UBaseType_t priority` in definitions, plain types in
  # declarations (the const is not part of the function's signature).
  - { key: readability-avoid-const-params-in-decls.IgnoreMacros, value: true }
  - { key: misc-const-correctness.AnalyzeValues, value: true }
  - { key: misc-const-correctness.AnalyzeReferences, value: true }
  - { key: misc-const-correctness.WarnPointersAsValues, value: true }
  - { key: misc-const-correctness.TransformPointersAsValues, value: false }
  # `Task(const Task&) = delete;` is the whole story: no move either.
  - { key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted, value: true }
...
