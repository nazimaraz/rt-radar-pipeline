# Run and debug the firmware on QEMU's MPS2 AN386 model.
#
# Configuring writes a launcher, build/<preset>/run-qemu, with this machine's
# QEMU path and the firmware's path filled in. The run targets below and the
# CLion run configuration in .run/ all start QEMU through it, so no path is
# hard-coded anywhere else. Extra arguments go to QEMU.
find_program(QEMU_ARM qemu-system-arm)

set(QEMU_LAUNCHER ${CMAKE_BINARY_DIR}/run-qemu)
if(QEMU_ARM)
    set(QEMU_ARGS -machine mps2-an386 -cpu cortex-m4 -nographic
                  -semihosting-config enable=on,target=native)
    list(JOIN QEMU_ARGS " " _qemu_args)
    set(_launch "exec \"${QEMU_ARM}\" ${_qemu_args} -kernel \"$<TARGET_FILE:firmware>\" \"$@\"")
else()
    set(_launch "echo 'qemu-system-arm was not found when CMake configured this build' >&2\nexit 1")
endif()
file(GENERATE OUTPUT ${QEMU_LAUNCHER}
    CONTENT "#!/bin/sh\n# Generated by cmake/qemu.cmake. Quit QEMU with Ctrl-A, then X.\n${_launch}\n"
    FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
                     GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)

if(QEMU_ARM)
    add_custom_target(run
        COMMAND ${QEMU_LAUNCHER}
        DEPENDS firmware USES_TERMINAL VERBATIM)
    # Halts at reset and waits for GDB on localhost:1234.
    add_custom_target(debug-server
        COMMAND ${QEMU_LAUNCHER} -s -S
        DEPENDS firmware USES_TERMINAL VERBATIM)
endif()
